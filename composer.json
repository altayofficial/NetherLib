{
  "name": "altayofficial/netherlib",
  "description": "NetherNet server and client for Minecraft: Bedrock Edition, written in PHP",
  "type": "library",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": "^8.3",
    "ext-datachannel": "^0.1.0",
    "ext-gmp": "*",
    "ext-openssl": "*",
    "ext-sockets": "*",
    "altayofficial/binaryutils": "^0.2.8",
    "altayofficial/log": "^0.4.1",
    "psr/log": "^3.0",
    "react/event-loop": "^1.5",
    "react/http": "^1.11"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  },
  "autoload": {
    "psr-4": {
      "altay\\netherlib\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "altay\\netherlib\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  }
}
